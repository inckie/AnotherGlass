<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top-Right: Battery Status indicator -->
    <TextView
        android:id="@+id/battery_value"
        style="@style/GlassSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="@dimen/glass_card_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="🔋 85% ⚡" />

    <!-- Center Content: Phone Connection Status -->
    <LinearLayout
        android:id="@+id/body_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/glass_card_margin"
        android:layout_marginEnd="@dimen/glass_card_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/ok_glass"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_phone_android" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/service_state"
                style="@style/GlassTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Connect to Phone" />

            <TextView
                android:id="@+id/hint"
                style="@style/GlassSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Tap to connect • Long tap for options" />

            <TextView
                android:id="@+id/two_finger_tap_hint"
                style="@style/GlassHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/hint_two_finger_tap_launcher" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom-Left: "OK Glass" prompt -->
    <TextView
        android:id="@+id/ok_glass"
        style="@style/GlassHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/glass_card_margin"
        android:layout_marginBottom="24dp"
        android:text="@string/ok_glass"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>