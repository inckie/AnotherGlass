<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Left Column: Album Artwork or Music Placeholder -->
    <FrameLayout
        android:id="@+id/left_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent=".36">

        <androidx.cardview.widget.CardView
            android:id="@+id/artwork_card"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@android:color/black"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false">

            <ImageView
                android:id="@+id/media_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/media_artwork_content_description"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_music_50" />

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- Right Column: Track Information -->
    <LinearLayout
        android:id="@+id/body_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/left_column"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Status & App Badge -->
        <LinearLayout
            android:id="@+id/status_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/media_state_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/glass_subtitle_text" />

            <TextView
                android:id="@+id/media_status"
                style="@style/GlassHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/glass_subtitle_text"
                android:textSize="16sp"
                tools:text="PLAYING • SPOTIFY" />

        </LinearLayout>

        <!-- Track Title -->
        <TextView
            android:id="@+id/media_title"
            style="@style/GlassTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.05"
            android:maxLines="2"
            tools:text="Voodoo Child (remix)" />

        <!-- Artist -->
        <TextView
            android:id="@+id/media_artist"
            style="@style/GlassSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Brick+Mortar" />

    </LinearLayout>

    <!-- Bottom Footer Hint (positioned safely above ViewPager indicator dots) -->
    <TextView
        android:id="@+id/footer"
        style="@style/GlassHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:ellipsize="end"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/left_column"
        tools:text="Tap: Pause  •  2× Tap: Next" />

</androidx.constraintlayout.widget.ConstraintLayout>
